{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "model": "openai/gpt-6.1-sol",
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "external_directory": {
      "*": "ask",
      "/Users/gianluca/shared/agents/**": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "options": {
            "reasoningEffort": "medium",
            "serviceTier": "priority"
          }
        }
      }
    },
    "ollama": {
      "models": {
        "gemma4:31b": {
          "_launch": true,
          "name": "gemma4:31b"
        },
        "gemma4:e4b": {
          "_launch": true,
          "name": "gemma4:e4b"
        },
        "qwen3-coder-next:q4_K_M": {
          "_launch": true,
          "name": "qwen3-coder-next:q4_K_M"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
