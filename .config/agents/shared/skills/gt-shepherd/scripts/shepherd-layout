#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: shepherd-layout [status | auto | toggle | cycle | <view>] [--base <ref>] [--root <dir>]

Set up, show, or change the gt-shepherd panes in the current Herdr tab.

Views: the agent column, then tool columns in the order nvim, hunk, shell.
  2 columns: agent:hunk  agent:shell  agent:nvim
  3 columns: agent:nvim:hunk  agent:nvim:shell  agent:hunk:shell

Commands:
  status   Print the current view. Change nothing. This is the default command.
  auto     Show agent:hunk when the Hunk diff has files. Else show agent:shell.
  toggle   Switch between 2 and 3 columns. Key: prefix+m.
             agent:hunk <-> agent:nvim:hunk     agent:shell <-> agent:nvim:shell
             agent:nvim  -> agent:nvim:hunk     agent:hunk:shell -> agent:hunk
  cycle    Show the next view with the same number of columns. Key: prefix+t.
             agent:hunk -> agent:shell -> agent:nvim -> agent:hunk
             agent:nvim:hunk -> agent:nvim:shell -> agent:hunk:shell -> agent:nvim:hunk
  <view>   Show this view.
  From a view outside these six, toggle and cycle act as auto.

Options:
  --base <ref>  Hunk base. Needed only when Hunk is not running. Choose it from context.
  --root <dir>  Project root for the tools. Default: the Hunk pane folder, else the agent folder.
                Fails when Neovim or Hunk already runs in another root. Quit it first.

Rules:
  Finds tool panes by label: shepherd:nvim, shepherd:hunk, shepherd:shell.
  Hidden tool panes wait in the tab labelled shepherd:shelf. Their processes keep running.
  Creates missing tool panes on the shelf. Lists them as new=.
  Starts tools only in panes at a shell prompt. Lists them as started=.
  Neovim listens on the shepherd-nvim socket. Shell stays at the prompt in the root.
  Names the space after the root folder and the agent tab "shepherd".
  Fails after the layout step when Hunk is not running and --base is missing.
  Moves only panes that differ from the target. A second run changes nothing.
  Resets column widths only when the number of columns changes.
  Never moves the agent pane. The first shown tool splits the agent pane.
  From a Herdr key command, finds the pane labelled shepherd in the active tab.

Output:
  One line: view=, files=, root=, panes=, widths=, then new= and started= when present.
  files= is the number of files in the Hunk diff, or "none" when Hunk is not running.

Examples:
  shepherd-layout auto --base origin/main
  shepherd-layout agent:nvim:shell
  shepherd-layout auto --root ../worktrees/KAI-580 --base origin/dev
EOF
}

die() {
  printf 'shepherd-layout: %s\n' "$*" >&2
  exit 1
}

declare -A toggled=(
  [agent:hunk]=agent:nvim:hunk [agent:nvim:hunk]=agent:hunk
  [agent:shell]=agent:nvim:shell [agent:nvim:shell]=agent:shell
  [agent:nvim]=agent:nvim:hunk [agent:hunk:shell]=agent:hunk
)
declare -A cycled=(
  [agent:hunk]=agent:shell [agent:shell]=agent:nvim [agent:nvim]=agent:hunk
  [agent:nvim:hunk]=agent:nvim:shell [agent:nvim:shell]=agent:hunk:shell [agent:hunk:shell]=agent:nvim:hunk
)

if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
  agent="" workspace="$HERDR_ACTIVE_WORKSPACE_ID" active_tab="${HERDR_ACTIVE_TAB_ID:-}"
elif [[ "${HERDR_ENV:-}" == 1 ]]; then
  agent="$HERDR_PANE_ID" workspace="$HERDR_WORKSPACE_ID" active_tab=""
else
  die "Not inside Herdr. Run from the agent pane or a Herdr key command."
fi
tools=(nvim hunk shell)
declare -A pane_of tab_of cwd_of
root="" view="custom" files="none" main="" shelf="" base="" hunk_error="" layout_json=""
created=() started=() shown=()
scripts="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || (cd "$1" && pwd); }

load_panes() {
  local list id tab label cwd
  list="$(herdr pane list --workspace "$workspace" 2>&1)" || die "Cannot list panes of workspace $workspace: $list"
  if [[ -z "$agent" ]]; then
    agent="$(jq -r --arg t "$active_tab" '[.result.panes[] | select(.label == "shepherd")] | (map(select(.tab_id == $t)) + .)[0].pane_id // ""' <<<"$list")"
    [[ -n "$agent" ]] || die "No pane labelled shepherd in workspace $workspace. Run /gt-shepherd first."
  fi
  main="$(jq -r --arg a "$agent" '.result.panes[] | select(.pane_id == $a) | .tab_id' <<<"$list")"
  [[ -n "$main" ]] || die "Agent pane $agent is not in workspace $workspace."
  while IFS=$'\t' read -r id tab label cwd; do
    pane_of[$label]="$id" tab_of[$id]="$tab" cwd_of[$id]="$cwd"
  done < <(jq -r '.result.panes[] | select(.label // "" | startswith("shepherd")) | [.pane_id, .tab_id, .label, .cwd] | @tsv' <<<"$list")
  list="$(herdr tab list --workspace "$workspace")"
  shelf="$(jq -r '[.result.tabs[] | select(.label == "shepherd:shelf") | .tab_id][0] // ""' <<<"$list")"
}

choose_root() {
  local requested="$1" hunk="${pane_of[shepherd:hunk]:-}"
  if [[ -n "$requested" ]]; then
    [[ -d "$requested" ]] || die "Root $requested is not a folder. Pass an existing project folder."
    root="$(toplevel "$requested")"
  elif [[ -n "$hunk" ]]; then
    root="$(toplevel "${cwd_of[$hunk]}")"
  else
    root="$(toplevel "${cwd_of[$agent]}")"
  fi
}

shelf_pane() {
  local id
  for id in "${!tab_of[@]}"; do
    if [[ "${tab_of[$id]}" == "$shelf" ]]; then printf '%s\n' "$id"; return; fi
  done
}

load_shown() {
  layout_json="$(herdr pane layout --pane "$agent")"
  mapfile -t shown < <(jq -r --arg a "$agent" '.result.layout.panes | sort_by(.rect.x, .rect.y)[] | select(.pane_id != $a) | .pane_id' <<<"$layout_json")
}

tool_of() {
  local tool
  for tool in "${tools[@]}"; do
    if [[ "${pane_of[shepherd:$tool]:-}" == "$1" ]]; then printf '%s\n' "$tool"; return; fi
  done
}

create_missing() {
  local tool id result target
  for tool in "${tools[@]}"; do
    [[ -z "${pane_of[shepherd:$tool]:-}" ]] || continue
    target="$(shelf_pane)"
    if [[ -n "$target" ]]; then
      id="$(herdr pane split "$target" --direction down --cwd "$root" --no-focus | jq -r '.result.pane.pane_id')"
    else
      result="$(herdr tab create --workspace "$workspace" --cwd "$root" --label shepherd:shelf --no-focus)"
      shelf="$(jq -r '.result.tab.tab_id' <<<"$result")"
      id="$(jq -r '.result.root_pane.pane_id' <<<"$result")"
    fi
    herdr pane rename "$id" "shepherd:$tool" >/dev/null
    pane_of[shepherd:$tool]="$id" tab_of[$id]="$shelf" cwd_of[$id]="$root"
    created+=("$tool")
  done
}

name_space() {
  local label
  label="$(herdr workspace get "$workspace" | jq -r .result.workspace.label)"
  [[ "$label" == "$(basename "$root")" ]] || herdr workspace rename "$workspace" "$(basename "$root")" >/dev/null
  label="$(herdr tab get "$main" | jq -r .result.tab.label)"
  [[ "$label" == shepherd ]] || herdr tab rename "$main" shepherd >/dev/null
}

move() {
  local tool="$1" result id tab
  shift
  result="$(herdr pane move "${pane_of[shepherd:$tool]}" "$@" --no-focus)"
  id="$(jq -r '.result.move_result.pane.pane_id' <<<"$result")"
  tab="$(jq -r '.result.move_result.pane.tab_id' <<<"$result")"
  pane_of[shepherd:$tool]="$id" tab_of[$id]="$tab"
}

show() { move "$1" --tab "$main" --target-pane "$2" --split right; }

hide() {
  local target
  target="$(shelf_pane)"
  if [[ -n "$shelf" && -n "$target" ]]; then
    move "$1" --tab "$shelf" --target-pane "$target" --split down
  else
    move "$1" --new-tab --workspace "$workspace" --label shepherd:shelf
    shelf="${tab_of[${pane_of[shepherd:$1]}]}"
  fi
}

set_agent_width() {
  local ratio="$1" current change
  load_shown
  current="$(jq -r --arg a "$agent" '.result.layout as $l | ($l.panes[] | select(.pane_id == $a) | .rect.width) / $l.area.width' <<<"$layout_json")"
  change="$(jq -n --argjson c "$current" --argjson r "$ratio" '$r - $c')"
  if jq -e -n --argjson d "$change" '$d > 0.02' >/dev/null; then
    herdr pane resize --pane "$agent" --direction right --amount "$change" >/dev/null
  elif jq -e -n --argjson d "$change" '$d < -0.02' >/dev/null; then
    herdr pane resize --pane "$agent" --direction left --amount "${change#-}" >/dev/null
  fi
}

foreground() {
  local info
  info="$(herdr pane process-info --pane "$1")" || die "Cannot read processes of pane $1."
  jq -c '.result.process_info.foreground_processes' <<<"$info"
}

is_idle() { jq -e 'all(.name == "bash" or .name == "zsh" or .name == "fish" or .name == "sh")' <<<"$(foreground "$1")" >/dev/null; }

check_tool_root() {
  local tool="$1" id="${pane_of[shepherd:$1]}" cwd
  is_idle "$id" && return 0
  cwd="$(jq -r '.[0].cwd // ""' <<<"$(foreground "$id")")"
  [[ -z "$cwd" || "$(toplevel "$cwd")" == "$root" ]] && return 0
  die "$tool runs in $cwd, not in root $root. Quit $tool in pane $id first. Then rerun."
}

start_tools() {
  local id sha
  id="${pane_of[shepherd:nvim]}"
  if is_idle "$id"; then
    herdr pane run "$id" "cd $(printf '%q' "$root") && $(HERDR_TAB_ID="$main" "$scripts/shepherd-nvim" start)" >/dev/null
    started+=(nvim)
  fi
  id="${pane_of[shepherd:shell]}"
  if is_idle "$id" && [[ "$(toplevel "${cwd_of[$id]}")" != "$root" ]]; then
    herdr pane run "$id" "cd $(printf '%q' "$root")" >/dev/null
  fi
  id="${pane_of[shepherd:hunk]}"
  is_idle "$id" || return 0
  if [[ -z "$base" ]]; then
    hunk_error="Hunk is not running in $id. Choose a base from context. Rerun with --base <ref>."
    return 0
  fi
  if ! sha="$(git -C "$root" rev-parse --verify --quiet "$base^{commit}")"; then
    hunk_error="Base $base is not a commit in $root. Fetch it, or choose another base."
    return 0
  fi
  herdr pane run "$id" "cd $(printf '%q' "$root") && hunk diff $sha --watch --agent-notes" >/dev/null
  started+=(hunk)
}

# Hunk registers its session a moment after start, so wait for it.
count_files() {
  local pid="" _
  for _ in {1..20}; do
    pid="$(jq -r '[.[] | select(.name == "hunk") | .pid][0] // ""' <<<"$(foreground "${pane_of[shepherd:hunk]}")")"
    [[ -n "$pid" ]] || { sleep 0.25; continue; }
    files="$(hunk session list --json 2>/dev/null | jq -r --argjson p "$pid" '[.sessions[] | select(.pid == $p) | .fileCount][0] // "none"')"
    [[ "$files" == none ]] || return 0
    sleep 0.25
  done
  files=none
}

detect() {
  local id tool
  load_shown
  view=agent
  for id in "${shown[@]}"; do
    tool="$(tool_of "$id")"
    [[ -n "$tool" ]] || { view=custom; return; }
    view+=":$tool"
  done
  [[ -n "${cycled[$view]:-}" ]] || view=custom
}

auto_view() {
  count_files
  if [[ "$files" =~ ^[1-9] ]]; then printf 'agent:hunk\n'; else printf 'agent:shell\n'; fi
}

target_view() {
  detect
  case "$1" in
    auto) auto_view ;;
    toggle) if [[ "$view" == custom ]]; then auto_view; else printf '%s\n' "${toggled[$view]}"; fi ;;
    cycle) if [[ "$view" == custom ]]; then auto_view; else printf '%s\n' "${cycled[$view]}"; fi ;;
    *) printf '%s\n' "$1" ;;
  esac
}

report() {
  local id names=() widths
  detect
  [[ "$files" != none ]] || count_files
  for id in "${shown[@]}"; do names+=("$(tool_of "$id"):$id"); done
  widths="$(jq -r '[.result.layout.panes | sort_by(.rect.x, .rect.y)[] | .rect.width] | join(",")' <<<"$layout_json")"
  local IFS=,
  printf 'view=%s files=%s root=%s panes=agent:%s,%s widths=%s' "$view" "$files" "$root" "$agent" "${names[*]}" "$widths"
  [[ ${#created[@]} -eq 0 ]] || printf ' new=%s' "${created[*]}"
  [[ ${#started[@]} -eq 0 ]] || printf ' started=%s' "${started[*]}"
  printf '\n'
}

apply() {
  local want=() id tool target before i
  IFS=: read -r -a want <<<"${1#agent:}"
  load_shown
  before=${#shown[@]}

  for tool in "${want[@]}"; do
    [[ "${tab_of[${pane_of[shepherd:$tool]}]}" != "$main" ]] || continue
    target="$agent"
    [[ ${#shown[@]} -eq 0 ]] || target="${shown[-1]}"
    show "$tool" "$target"
    shown+=("${pane_of[shepherd:$tool]}")
  done

  for id in "${shown[@]}"; do
    tool="$(tool_of "$id")"
    [[ -n "$tool" && " ${want[*]} " != *" $tool "* ]] || continue
    hide "$tool"
  done

  for i in "${!want[@]}"; do
    load_shown
    id="${pane_of[shepherd:${want[$i]}]}"
    [[ "${shown[$i]}" == "$id" ]] || herdr pane swap --source-pane "$id" --target-pane "${shown[$i]}" >/dev/null
  done

  if [[ $before -ne ${#want[@]} ]]; then set_agent_width "$(jq -n --argjson n "${#want[@]}" '1 / ($n + 1)')"; fi
}

command="status" requested_root=""
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --base) [[ -n "${2:-}" ]] || die "--base needs a ref."; base="$2"; shift 2 ;;
    --root) [[ -n "${2:-}" ]] || die "--root needs a folder."; requested_root="$2"; shift 2 ;;
    -*) die "Unknown option: $1. Run shepherd-layout --help." ;;
    *) positional+=("$1"); shift ;;
  esac
done
[[ ${#positional[@]} -le 1 ]] || die "Too many arguments. Run shepherd-layout --help."
[[ ${#positional[@]} -lt 1 ]] || command="${positional[0]}"
case "$command" in
  status | auto | toggle | cycle) ;;
  agent:*) [[ -n "${cycled[$command]:-}" ]] || die "Unknown view: $command. Run shepherd-layout --help for the six views." ;;
  *) die "Unknown command: $command. Old develop and review layouts are gone. Read SKILL.md again, or run shepherd-layout --help." ;;
esac

load_panes
choose_root "$requested_root"
if [[ "$command" == status ]]; then report; exit 0; fi

herdr pane rename "$agent" shepherd >/dev/null
create_missing
check_tool_root nvim
check_tool_root hunk
start_tools
name_space
apply "$(target_view "$command")"
report
[[ -z "$hunk_error" ]] || die "$hunk_error"
