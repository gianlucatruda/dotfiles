#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'HELP'
Usage: shepherd-layout [ensure | status | toggle | cycle | <view>] [--base <ref>] [--root <dir>]

Start or resume Shepherd in the current Herdr tab. Default command: ensure.

Commands:
  ensure   Start fresh with agent:shell. Preserve existing views, widths, and focus.
  status   Report the layout and Hunk file count. Change nothing. Never wait for Hunk.
  toggle   Switch between paired two-column and three-column views. Key: prefix+m.
  cycle    Cycle tools within the current column count. Key: prefix+t.
  <view>   Select one of the six views below.

Views, toggle pairs, and cycle order:
  Two columns:    agent:shell       -> agent:nvim       -> agent:hunk       -> repeat
  Three columns: agent:hunk:shell  -> agent:nvim:shell -> agent:nvim:hunk -> repeat
  Toggle connects matching positions. Toggle twice restores the view.

Options:
  --root <dir>  Existing project folder. Default: an owned tool's folder, then the agent folder.
  --base <ref>  Hunk base commit. Default: branch upstream, then HEAD.
                Used when starting Hunk. A running Hunk must already use this explicit base.
  --help       Show this help. Works outside Herdr.

Behavior:
  Start tools only when requested. Keep hidden tools running in a shelf owned by this tab.
  Equalize widths when column count changes. Preserve widths during tool-only switches.
  Preserve custom arrangements. Restore tool columns before selecting another view.
  Validate roots and Hunk bases before changing panes. Never move the agent pane.
  Key commands use only the active tab's Shepherd agent. Run /gt-shepherd there first.

Output:
  view, files, root, panes, widths, and optional new and started fields.
  files is a count, not-started, or unknown. Unknown never means an empty diff.

Examples:
  shepherd-layout
  shepherd-layout agent:hunk --base origin/main
  shepherd-layout agent:nvim:shell --root ../worktree
HELP
}

die() {
  printf 'shepherd-layout: %s\n' "$*" >&2
  exit 1
}

declare -A transitions=(
  [agent:shell]='agent:hunk:shell agent:nvim'
  [agent:nvim]='agent:nvim:shell agent:hunk'
  [agent:hunk]='agent:nvim:hunk agent:shell'
  [agent:hunk:shell]='agent:shell agent:nvim:shell'
  [agent:nvim:shell]='agent:nvim agent:nvim:hunk'
  [agent:nvim:hunk]='agent:hunk agent:hunk:shell'
)

command=ensure requested_root="" base=""
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --base) [[ -n "${2:-}" ]] || die "--base needs a ref. Pass an existing commit."; base="$2"; shift 2 ;;
    --root) [[ -n "${2:-}" ]] || die "--root needs a folder. Pass an existing folder."; requested_root="$2"; shift 2 ;;
    -*) die "Unknown option: $1. Run shepherd-layout --help." ;;
    *) positional+=("$1"); shift ;;
  esac
done
[[ ${#positional[@]} -le 1 ]] || die "Too many commands. Run shepherd-layout --help."
[[ ${#positional[@]} -eq 0 ]] || command="${positional[0]}"
case "$command" in
  ensure | status | toggle | cycle) ;;
  *) [[ -n "${transitions[$command]:-}" ]] || die "Unknown command: $command. Run shepherd-layout --help." ;;
esac

if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
  agent="" workspace="$HERDR_ACTIVE_WORKSPACE_ID" active_tab="${HERDR_ACTIVE_TAB_ID:-}"
  [[ -n "$active_tab" ]] || die "No active tab was supplied. Run /gt-shepherd in the target tab."
elif [[ "${HERDR_ENV:-}" == 1 ]]; then
  agent="${HERDR_PANE_ID:?}" workspace="${HERDR_WORKSPACE_ID:?}" active_tab=""
else
  die "Not inside Herdr. Run from the agent pane or a Herdr key command."
fi

tools=(nvim hunk shell)
declare -A pane_of tab_of cwd_of process_of
root="" view=fresh main="" shelf="" shelf_label="" layout_json="" nvim_command="" sha="" name_workspace=false legacy_shelf=false
created=() started=() shown=() want=()
scripts="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || (cd "$1" && pwd); }

load_panes() {
  local list tabs id tab cwd tool
  list="$(herdr pane list --workspace "$workspace")" || die "Cannot read workspace $workspace. Check socket access."
  if [[ -z "$agent" ]]; then
    agent="$(jq -r --arg t "$active_tab" '[.result.panes[] | select(.label == "shepherd" and .tab_id == $t)] | if length == 1 then .[0].pane_id else "" end' <<<"$list")"
    [[ -n "$agent" ]] || die "No unique Shepherd agent in tab $active_tab. Run /gt-shepherd there first."
  fi
  while IFS=$'\t' read -r id tab cwd; do
    tab_of[$id]="$tab" cwd_of[$id]="$cwd"
  done < <(jq -r '.result.panes[] | [.pane_id, .tab_id, .cwd] | @tsv' <<<"$list")
  main="${tab_of[$agent]:-}"
  [[ -n "$main" ]] || die "Agent pane $agent is missing. Run from its Herdr pane."
  shelf_label="shepherd:shelf:$main"
  tabs="$(herdr tab list --workspace "$workspace")"
  name_workspace="$(jq -r '.result.tabs | length == 1' <<<"$tabs")"
  shelf="$(jq -r --arg label "$shelf_label" '[.result.tabs[] | select(.label == $label)] | if length > 1 then error("Duplicate Shepherd shelves") else .[0].tab_id // "" end' <<<"$tabs")"
  if [[ -z "$shelf" ]]; then
    shelf="$(jq -r '[.result.tabs[] | select(.label == "shepherd:shelf")] | if length > 1 then error("Duplicate legacy shelves") else .[0].tab_id // "" end' <<<"$tabs")"
    if [[ -n "$shelf" ]]; then
      jq -e --arg agent "$agent" '[.result.panes[] | select(.label == "shepherd")] | length == 1 and .[0].pane_id == $agent' <<<"$list" >/dev/null || die "The legacy shelf has multiple possible owners. Separate its tools before resuming Shepherd."
      legacy_shelf=true
    fi
  fi
  while IFS=$'\t' read -r id tool; do
    [[ -z "${pane_of[$tool]:-}" ]] || die "Duplicate $tool panes in tab $main. Rename the unrelated pane."
    pane_of[$tool]="$id"
  done < <(jq -r --arg m "$main" --arg s "$shelf" '.result.panes[] | select(.tab_id == $m or .tab_id == $s) | select(.label == "shepherd:nvim" or .label == "shepherd:hunk" or .label == "shepherd:shell") | [.pane_id, (.label | ltrimstr("shepherd:"))] | @tsv' <<<"$list")
}

choose_root() {
  local tool cwd processes
  if [[ -n "$requested_root" ]]; then
    [[ -d "$requested_root" ]] || die "Root $requested_root is missing. Pass an existing folder."
    root="$(toplevel "$requested_root")"
    return
  fi
  for tool in hunk nvim shell; do
    if [[ -n "${pane_of[$tool]:-}" ]]; then
      if [[ "$tool" != shell ]]; then
        processes="$(foreground "${pane_of[$tool]}")"
        cwd="$(jq -r --arg tool "$tool" '[.[] | select(.name == $tool) | .cwd][0] // ""' <<<"$processes")"
        if [[ -n "$cwd" ]]; then root="$(toplevel "$cwd")"; return; fi
      fi
      root="$(toplevel "${cwd_of[${pane_of[$tool]}]}")"
      return
    fi
  done
  root="$(toplevel "${cwd_of[$agent]}")"
}

load_shown() {
  local panes
  layout_json="$(herdr pane layout --pane "$agent")"
  panes="$(jq -r --arg a "$agent" '.result.layout.panes | sort_by(.rect.x, .rect.y)[] | select(.pane_id != $a) | .pane_id' <<<"$layout_json")"
  shown=()
  [[ -z "$panes" ]] || mapfile -t shown <<<"$panes"
}

tool_of() {
  local tool
  for tool in "${tools[@]}"; do
    if [[ "${pane_of[$tool]:-}" == "$1" ]]; then printf '%s\n' "$tool"; return; fi
  done
}

detect() {
  local id tool
  load_shown
  view=custom
  jq -e --arg a "$agent" '.result.layout as $l | ($l.panes | sort_by(.rect.x, .rect.y) | .[0].pane_id) == $a and all($l.panes[]; .rect.y == $l.area.y and .rect.height == $l.area.height)' <<<"$layout_json" >/dev/null || return 0
  view=agent
  for id in "${shown[@]}"; do
    tool="$(tool_of "$id")"
    [[ -n "$tool" ]] || { view=custom; return; }
    view+=":$tool"
  done
  if [[ "$view" == agent ]]; then view=fresh
  elif [[ -z "${transitions[$view]:-}" ]]; then view=custom
  fi
}

foreground() {
  local info
  info="$(herdr pane process-info --pane "$1")" || die "Cannot read pane $1. Check socket access."
  jq -ce '.result.process_info.foreground_processes' <<<"$info"
}

is_idle() { jq -e 'length > 0 and all(.name == "bash" or .name == "zsh" or .name == "fish" or .name == "sh")' <<<"$1" >/dev/null; }

preflight() {
  local tool id cwd processes state
  for tool in "${tools[@]}"; do
    id="${pane_of[$tool]:-}"
    [[ -n "$id" ]] || continue
    processes="$(foreground "$id")"
    process_of[$tool]="$processes"
    if [[ "$tool" == shell && "$(toplevel "${cwd_of[$id]}")" == "$root" ]]; then continue; fi
    is_idle "$processes" && continue
    cwd="$(jq -r '.[0].cwd // ""' <<<"$processes")"
    [[ -n "$cwd" ]] || die "Cannot locate $tool in pane $id. Check its foreground process."
    [[ "$(toplevel "$cwd")" == "$root" ]] || die "$tool runs in $cwd. Quit it before switching to $root."
  done
  if [[ "$view" != "$target" && -n "${pane_of[nvim]:-}" ]] && jq -e 'any(.name == "nvim")' <<<"${process_of[nvim]}" >/dev/null; then
    state="$(HERDR_TAB_ID="$main" "$scripts/shepherd-nvim" read)"
    jq -e '.mode | test("^(i|R|s|S|\u0013|c|t)") | not' <<<"$state" >/dev/null || die "The human is typing in Neovim. Wait before switching views."
  fi
  for tool in "${want[@]}"; do
    processes="${process_of[$tool]:-[]}"
    if [[ -n "${pane_of[$tool]:-}" ]] && ! is_idle "$processes" && [[ "$tool" != shell ]]; then
      jq -e --arg tool "$tool" 'any(.name == $tool)' <<<"$processes" >/dev/null || die "Another job occupies the $tool pane. Wait for its shell prompt."
    fi
    case "$tool" in
      nvim)
        if [[ -z "${pane_of[nvim]:-}" ]] || is_idle "$processes"; then
          nvim_command="$(HERDR_TAB_ID="$main" "$scripts/shepherd-nvim" start)"
        fi
        ;;
      hunk)
        if [[ -z "${pane_of[hunk]:-}" ]] || is_idle "$processes" || [[ -n "$base" ]]; then
          if [[ -z "$base" ]]; then
            base="$(git -C "$root" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || base=HEAD
          fi
          sha="$(git -C "$root" rev-parse --verify --quiet "$base^{commit}")" || die "Base $base is missing in $root. Fetch it or pass --base <ref>."
          if [[ -n "${pane_of[hunk]:-}" ]] && ! is_idle "$processes"; then
            jq -e --arg sha "$sha" 'any(.name == "hunk" and any(.argv[]; . == $sha))' <<<"$processes" >/dev/null || die "Hunk uses another base. Quit it, then rerun with --base $base."
          fi
        fi
        ;;
      shell) ;;
    esac
  done
}

create_missing() {
  local tool id target_pane result
  for tool in "${want[@]}"; do
    [[ -z "${pane_of[$tool]:-}" ]] || continue
    load_shown
    target_pane="$agent"
    [[ ${#shown[@]} -eq 0 ]] || target_pane="${shown[-1]}"
    result="$(herdr pane split "$target_pane" --direction right --cwd "$root" --no-focus)"
    id="$(jq -er '.result.pane.pane_id' <<<"$result")"
    herdr pane rename "$id" "shepherd:$tool" >/dev/null
    pane_of[$tool]="$id" tab_of[$id]="$main" cwd_of[$id]="$root"
    created+=("$tool")
  done
}

start_tools() {
  local tool id processes _
  for tool in "${want[@]}"; do
    id="${pane_of[$tool]}"
    for _ in {1..20}; do
      processes="$(foreground "$id")"
      is_idle "$processes" && break
      [[ " ${created[*]} " == *" $tool "* ]] || break
      sleep 0.1
    done
    if ! is_idle "$processes"; then
      [[ " ${created[*]} " != *" $tool "* ]] || die "The new $tool pane has no shell prompt. Wait, then rerun."
      continue
    fi
    case "$tool" in
      nvim)
        [[ -n "$nvim_command" ]] || continue
        herdr pane run "$id" "cd $(printf '%q' "$root") && $nvim_command" >/dev/null
        started+=(nvim)
        ;;
      hunk)
        herdr pane run "$id" "cd $(printf '%q' "$root") && hunk diff $sha --watch --agent-notes" >/dev/null
        started+=(hunk)
        ;;
      shell)
        [[ "${cwd_of[$id]}" == "$root" ]] || herdr pane run "$id" "cd $(printf '%q' "$root")" >/dev/null
        ;;
    esac
    [[ "$tool" != shell ]] || continue
    for _ in {1..50}; do
      processes="$(foreground "$id")"
      jq -e --arg tool "$tool" 'any(.name == $tool)' <<<"$processes" >/dev/null && break
      sleep 0.1
    done
    jq -e --arg tool "$tool" 'any(.name == $tool)' <<<"$processes" >/dev/null || die "$tool did not start in pane $id. Read its output before retrying."
  done
}

move() {
  local tool="$1" result id
  shift
  result="$(herdr pane move "${pane_of[$tool]}" "$@" --no-focus)"
  id="$(jq -er '.result.move_result.pane.pane_id' <<<"$result")"
  pane_of[$tool]="$id"
  tab_of[$id]="$(jq -er '.result.move_result.pane.tab_id' <<<"$result")"
}

hide() {
  local tool="$1" target_pane="" id
  for id in "${!tab_of[@]}"; do
    if [[ -n "$shelf" && "${tab_of[$id]}" == "$shelf" ]]; then target_pane="$id"; break; fi
  done
  if [[ -n "$target_pane" ]]; then
    move "$tool" --tab "$shelf" --target-pane "$target_pane" --split down
  else
    move "$tool" --new-tab --workspace "$workspace" --label "$shelf_label"
    shelf="${tab_of[${pane_of[$tool]}]}"
  fi
}

resize_columns() {
  local weights="$1" order index id change direction measurement
  load_shown
  order="$(jq -r '
    .result.layout as $layout
    | ($layout.panes | sort_by(.rect.x)) as $panes
    | [range(0; ($panes | length) - 1) as $index
        | ($panes[$index].rect.x + $panes[$index].rect.width) as $edge
        | {index: $index, span: ([$layout.splits[]
            | select(.direction == "right"
                and ((.rect.x + ((.rect.width * .ratio) | round) - $edge) | fabs) <= 1)
            | .rect.width] | max)}]
    | sort_by(-.span)[].index
  ' <<<"$layout_json")"
  while IFS= read -r index; do
    load_shown
    measurement="$(jq -c --argjson index "$index" --argjson weights "$weights" '
      .result.layout as $layout
      | ($layout.panes | sort_by(.rect.x)) as $panes
      | ($panes[$index].rect.x + $panes[$index].rect.width) as $edge
      | ($layout.area.x + ($panes | map(.rect.width) | add)
          * ($weights[0:($index + 1)] | add) / ($weights | add) - $edge) as $delta
      | ([$layout.splits[]
          | select(.direction == "right"
              and ((.rect.x + ((.rect.width * .ratio) | round) - $edge) | fabs) <= 1)
          | .rect.width] | max) as $span
      | {delta: $delta, amount: (($delta | fabs) / $span),
          pane: $panes[$index + (if $delta < 0 then 1 else 0 end)].pane_id}
    ' <<<"$layout_json")"
    if jq -e '(.delta | fabs) > 1' <<<"$measurement" >/dev/null; then
      direction=right
      jq -e '.delta >= 0' <<<"$measurement" >/dev/null || direction=left
      id="$(jq -r .pane <<<"$measurement")"
      change="$(jq -r .amount <<<"$measurement")"
      herdr pane resize --pane "$id" --direction "$direction" --amount "$change" >/dev/null
    fi
  done <<<"$order"
}

apply() {
  local before="$1" id tool target_pane index
  load_shown
  for tool in "${want[@]}"; do
    [[ "${tab_of[${pane_of[$tool]}]}" != "$main" ]] || continue
    target_pane="$agent"
    [[ ${#shown[@]} -eq 0 ]] || target_pane="${shown[-1]}"
    move "$tool" --tab "$main" --target-pane "$target_pane" --split right
    load_shown
  done
  for id in "${shown[@]}"; do
    tool="$(tool_of "$id")"
    [[ " ${want[*]} " == *" $tool "* ]] || hide "$tool"
  done
  for index in "${!want[@]}"; do
    load_shown
    id="${pane_of[${want[$index]}]}"
    [[ "${shown[$index]}" == "$id" ]] || herdr pane swap --source-pane "$id" --target-pane "${shown[$index]}" >/dev/null
  done
  load_shown
  if [[ "$before" -ne ${#shown[@]} ]]; then
    weights="$(jq -cn --argjson n "$((${#shown[@]} + 1))" '[range($n) | 1]')"
  fi
  resize_columns "$weights"
}

report() {
  local files=not-started id names=() widths sessions processes pid tool
  detect
  id="${pane_of[hunk]:-}"
  if [[ -n "$id" ]]; then
    processes="$(foreground "$id")"
    pid="$(jq -r '[.[] | select(.name == "hunk") | .pid][0] // ""' <<<"$processes")"
    if [[ -n "$pid" ]]; then
      files=unknown
      if sessions="$(hunk session list --json)"; then
        files="$(jq -r --argjson pid "$pid" '[.sessions[] | select(.pid == $pid) | .fileCount][0] // "unknown"' <<<"$sessions")"
      fi
    fi
  fi
  for id in "${shown[@]}"; do
    tool="$(tool_of "$id")"
    names+=("${tool:-unmanaged}:$id")
  done
  widths="$(jq -r '[.result.layout.panes | sort_by(.rect.x, .rect.y)[] | .rect.width] | join(",")' <<<"$layout_json")"
  local IFS=,
  printf 'view=%s files=%s root=%s panes=agent:%s' "$view" "$files" "$root" "$agent"
  [[ ${#names[@]} -eq 0 ]] || printf ',%s' "${names[*]}"
  printf ' widths=%s' "$widths"
  [[ ${#created[@]} -eq 0 ]] || printf ' new=%s' "${created[*]}"
  [[ ${#started[@]} -eq 0 ]] || printf ' started=%s' "${started[*]}"
  printf '\n'
}

load_panes
choose_root
detect
if [[ "$command" == status || ( "$command" == ensure && "$view" == custom ) ]]; then report; exit 0; fi
[[ "$view" != custom ]] || die "Custom layout in tab $main. Restore tool columns before switching views."

target="$command"
case "$command" in
  ensure) target="$view"; [[ "$view" != fresh ]] || target=agent:shell ;;
  toggle | cycle)
    [[ "$view" != fresh ]] || die "No Shepherd view exists. Run /gt-shepherd first."
    read -r toggle_target cycle_target <<<"${transitions[$view]}"
    if [[ "$command" == toggle ]]; then target="$toggle_target"; else target="$cycle_target"; fi
    ;;
esac
IFS=: read -r -a want <<<"${target#agent:}"
preflight
before=${#shown[@]}
weights="$(jq -c '[.result.layout.panes | sort_by(.rect.x)[] | .rect.width]' <<<"$layout_json")"
[[ "$legacy_shelf" != true ]] || herdr tab rename "$shelf" "$shelf_label" >/dev/null
if [[ "$view" == fresh ]]; then
  herdr pane rename "$agent" shepherd >/dev/null
  [[ "$name_workspace" != true ]] || herdr workspace rename "$workspace" "$(basename "$root")" >/dev/null
  herdr tab rename "$main" shepherd >/dev/null
fi
create_missing
start_tools
[[ "$target" == "$view" ]] || apply "$before"
report
