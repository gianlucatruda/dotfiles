#!/usr/bin/env bash
# Version 0.1

if ! [[ -n $LOGDIR ]]; then
	LOGDIR="$HOME/3-Resources/Logs"
	echo -e "LOGDIR not set. Creating at '$LOGDIR'"
fi
mkdir -p "$LOGDIR"
DATETIME="$(date +%Y-%m-%d_%H-%M-%S)"
echo "$DATETIME"
LOGFILE="$LOGDIR/${DATETIME}_gt-sync-homelab.log"
echo "$LOGFILE"

# HOMELAB_HOME_DIR of format user@server.local:/home/user
if ! [[ -n $HOMELAB_HOME_DIR ]]; then
	echo -e "HOMELAB_HOME_DIR not set. Check ~/.config/.extra"
	exit 1 # Exit code 1 for error
fi

# TODO swaps scripts for media/media
SUBDIRS_TO_SYNC=(
	"homelab" \
	"media/media" \
)

BACKUP_DIRS=("$HOMELAB_BACKUP_DIR_01")
SSH_HOST="${HOMELAB_HOME_DIR%%:*}"
SSH_CONTROL_DIR=""
for DRIVE in "${BACKUP_DIRS[@]}"; do
	if ! [[ -n $DRIVE ]]; then
		echo -e "Backup path not properly specified. Check ~/.config/.extra"
		exit 1 # Exit code 1 for error
	fi
	if ! [[ -e "$DRIVE" && -d "$DRIVE" ]]; then
		echo -e "\n$DRIVE not found, skipping.\n"
		continue
	fi
	if [[ -z "$SSH_CONTROL_DIR" ]]; then
		SSH_CONTROL_DIR="$(mktemp -d /tmp/gt-sync-homelab.XXXXXX)" || exit 1
		trap 'ssh -S "$SSH_CONTROL_DIR/socket" -O exit "$SSH_HOST" >/dev/null 2>&1; rm -rf -- "$SSH_CONTROL_DIR"' EXIT
		trap 'exit 130' INT
		trap 'exit 143' TERM
		if ! ssh -M -S "$SSH_CONTROL_DIR/socket" -o ControlPersist=yes -fN "$SSH_HOST"; then
			echo "SSH connection failed. Check your credentials and connection, then retry." >&2
			exit 1
		fi
	fi
	echo -e "\n\nSyncing to '$DRIVE'...\n"
	for SUBDIR in "${SUBDIRS_TO_SYNC[@]}"; do
		(set -x; rsync -avhz \
			-e "ssh -S $SSH_CONTROL_DIR/socket -o BatchMode=yes -o ControlMaster=no" \
			--backup \
			--backup-dir="$DRIVE/Deleted/$DATETIME/$SUBDIR/" \
			--delete \
			--stats \
			--log-file="$LOGFILE" \
			--exclude='.DS_Store' \
			--exclude='.DocumentRevisions-V100' \
			--exclude='.Spotlight-V100' \
			--exclude='.TemporaryItems' \
			--exclude='.Trashes' \
			--exclude='._*' \
			--exclude='.fseventsd' \
			--exclude='.timemachine' \
			"$HOMELAB_HOME_DIR/$SUBDIR/" "$DRIVE/$SUBDIR/" \
		)
	done
	echo -e "\nFinished syncing from '$HOMELAB_HOME_DIR' to '$DRIVE'\n"
	echo -e "\nLogs written to '$LOGFILE'\n"
done

