#!/usr/bin/env bash

set -euo pipefail

main_dir="${TORTUS_MAIN_DIR:-$HOME/1-Projects/tortus/main}"
shared_dir="${TORTUS_SHARED_DIR:-$HOME/shared}"
verbose=false

usage() {
  cat <<'EOF'
Usage: gt-tortus-worktree [options] <command> [arguments]

Commands:
  init                 Create dev/fix and set up registered worktrees.
  new <name>           Create a worktree for a local, origin, or new branch.
  release <name>       Detach a clean worktree at origin/main.
  remove <name>        Remove one clean feature worktree.
  purge                Confirm, release, and remove all feature worktrees.
  status               Show branches, changed files, and line counts.

Options:
  -v, --verbose        Show setup output and allow prompts.
  -h, --help           Show help.

Rules:
  Init creates dev/fix under worktrees/ beside main and sets up registered worktrees.
  Setup runs pnpm dev-setup and agents/scripts/setup.sh --apply.
  Init links tmp/shared to TORTUS_SHARED_DIR and creates TORTUS_SHARED_DIR/agents/database-owner.txt.
  New fetches matching origin/<name> and sets it as upstream.
  New branches without a match start at origin/main without upstream.
  Existing branches without a match lose stale origin/main tracking.
  Release, remove, and purge require clean worktrees with no untracked files.
  Purge checks locks, lists direct registered feature worktrees, and requires typed 'purge' confirmation.
  Main, dev, fix, and all branches remain.
  Status follows lifecycle operations, including failures.

Environment:
  TORTUS_MAIN_DIR      Main worktree. Default: ~/1-Projects/tortus/main
  TORTUS_SHARED_DIR    Shared directory. Default: ~/shared
  NO_COLOR             Disable terminal colours when set.
EOF
}

die() {
  printf 'gt-tortus-worktree: %s\n' "$*" >&2
  exit 1
}

require_main_worktree() {
  local resolved
  local root

  resolved="$(cd "$main_dir" 2>/dev/null && pwd -P)" || die "Cannot find main worktree: $main_dir"
  root="$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null)" || die "Not a Git worktree: $main_dir"
  [[ "$root" == "$resolved" ]] || die "Main worktree must be a repository root: $main_dir"
  main_dir="$resolved"
  [[ "$(git -C "$main_dir" branch --show-current)" == 'main' ]] || die "Main worktree must check out main: $main_dir"
}

require_shared_directory() {
  local resolved
  resolved="$(cd "$shared_dir" 2>/dev/null && pwd -P)" || die "Cannot find shared directory: $shared_dir"
  shared_dir="$resolved"
}

worktrees_dir() {
  printf '%s/worktrees\n' "$(dirname "$main_dir")"
}

# Keep the cleanup trap local to this command.
run_setup_command() (
  local log_file
  local exit_code=0

  if [[ "$verbose" == true ]]; then
    "$@"
    exit
  fi

  log_file="$(mktemp "${TMPDIR:-/tmp}/gt-tortus-worktree.XXXXXX")"
  trap 'rm -f "$log_file"' EXIT
  "$@" </dev/null >"$log_file" 2>&1 || exit_code=$?
  if [[ "$exit_code" -ne 0 ]]; then
    cat "$log_file" >&2
  fi
  exit "$exit_code"
)

setup_worktree() {
  local worktree="$1"
  local shared_path="$worktree/tmp/shared"

  printf 'Setting up %s...\n' "$worktree"
  if [[ -L "$shared_path" ]]; then
    [[ "$(readlink "$shared_path")" == "$shared_dir" ]] || die "Unexpected shared link: $shared_path"
  elif [[ -e "$shared_path" ]]; then
    die "Shared path exists: $shared_path"
  fi

  run_setup_command pnpm -C "$worktree" dev-setup
  run_setup_command "$worktree/agents/scripts/setup.sh" --apply
  mkdir -p "$worktree/tmp"
  [[ -L "$shared_path" ]] || ln -s "$shared_dir" "$shared_path"
}

require_clean_worktree() {
  local worktree="$1"
  local changes

  changes="$(git -C "$worktree" status --porcelain --untracked-files=all)"
  [[ -z "$changes" ]] || die "Worktree has uncommitted changes: $worktree"
}

worktree_paths() {
  git -C "$main_dir" worktree list --porcelain | sed -n 's/^worktree //p'
}

git_common_dir() {
  local worktree="$1"
  local common_dir

  common_dir="$(git -C "$worktree" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ "$common_dir" == /* ]] || common_dir="$worktree/$common_dir"
  (cd "$common_dir" && pwd -P)
}

require_registered_worktree() {
  local expected="$1"
  local actual_root
  local actual_common_dir
  local main_common_dir

  actual_root="$(git -C "$expected" rev-parse --show-toplevel 2>/dev/null)" || die "Cannot read worktree: $expected"
  actual_root="$(cd "$actual_root" && pwd -P)" || die "Cannot resolve worktree: $expected"
  [[ "$actual_root" == "$expected" ]] || die "Not a worktree root: $expected"
  actual_common_dir="$(git_common_dir "$expected")" || die "Cannot read worktree: $expected"
  main_common_dir="$(git_common_dir "$main_dir")" || die "Cannot read main worktree: $main_dir"
  [[ "$actual_common_dir" == "$main_common_dir" ]] || die "Not a registered TORTUS worktree: $expected"
}

require_no_legacy_slots() {
  local parent
  local slot
  local legacy_slot

  parent="$(dirname "$main_dir")"
  for slot in dev fix; do
    legacy_slot="$parent/$slot"
    [[ ! -e "$legacy_slot" && ! -L "$legacy_slot" ]] || die "Resolve legacy slot before init: $legacy_slot"
  done
}

validate_worktree_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Use letters, numbers, dots, underscores, and hyphens"
}

create_slot() {
  local slot="$1"
  local worktree
  worktree="$(worktrees_dir)/$slot"

  if [[ -e "$worktree" || -L "$worktree" ]]; then
    require_registered_worktree "$worktree"
  else
    printf 'Creating %s...\n' "$worktree"
    run_setup_command git -C "$main_dir" worktree add --detach "$worktree" origin/main
  fi
}

init_worktrees() {
  local database_owner="$shared_dir/agents/database-owner.txt"
  local worktrees_root
  local registered_paths
  local worktree

  worktrees_root="$(worktrees_dir)"
  require_no_legacy_slots

  mkdir -p "$shared_dir/agents"
  if [[ -e "$database_owner" || -L "$database_owner" ]]; then
    [[ -f "$database_owner" ]] || die "Database owner path is not a file: $database_owner"
  else
    touch "$database_owner"
  fi

  mkdir -p "$worktrees_root"
  create_slot dev
  create_slot fix

  registered_paths="$(worktree_paths)"
  # Keep standard input available for verbose setup prompts.
  while IFS= read -r -u 3 worktree; do
    [[ "$worktree" == "$worktrees_root/"* && -d "$worktree" ]] || continue
    require_registered_worktree "$worktree"
    setup_worktree "$worktree"
  done 3<<< "$registered_paths"
}

new_worktree() {
  local branch="$1"
  local worktree
  local remote_check
  local upstream=''
  local existing_branch=false
  local origin_branch=false

  validate_worktree_name "$branch"
  git -C "$main_dir" check-ref-format --branch "$branch" >/dev/null || die "Invalid Git branch name: $branch"
  worktree="$(worktrees_dir)/$branch"
  [[ "$branch" != 'dev' && "$branch" != 'fix' ]] || die "Use the persistent $branch worktree"
  [[ ! -e "$worktree" && ! -L "$worktree" ]] || die "Worktree already exists: $worktree"
  if [[ "$verbose" == false ]]; then
    export GIT_TERMINAL_PROMPT=0
  fi
  if git -C "$main_dir" show-ref --verify --quiet "refs/heads/$branch"; then
    existing_branch=true
  fi
  if git -C "$main_dir" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null; then
    origin_branch=true
  else
    remote_check=$?
    [[ "$remote_check" -eq 2 ]] || die "Cannot check origin for branch: $branch"
  fi
  if [[ "$existing_branch" == true && "$origin_branch" == false ]]; then
    upstream="$(git -C "$main_dir" for-each-ref --format='%(upstream:short)' "refs/heads/$branch")" || die "Cannot read upstream: $branch"
  fi

  printf 'Creating %s...\n' "$worktree"
  mkdir -p "$(worktrees_dir)"
  if [[ "$origin_branch" == true ]]; then
    run_setup_command git -C "$main_dir" fetch --no-tags origin "+refs/heads/$branch:refs/remotes/origin/$branch"
  fi
  if [[ "$existing_branch" == true ]]; then
    run_setup_command git -C "$main_dir" worktree add "$worktree" "$branch"
    if [[ "$origin_branch" == true ]]; then
      run_setup_command git -C "$worktree" branch --set-upstream-to="origin/$branch"
      printf 'Tracking origin/%s\n' "$branch"
    elif [[ "$upstream" == 'origin/main' ]]; then
      run_setup_command git -C "$worktree" branch --unset-upstream
      printf 'Cleared origin/main upstream for %s\n' "$branch"
    fi
  elif [[ "$origin_branch" == true ]]; then
    run_setup_command git -C "$main_dir" worktree add --track -b "$branch" "$worktree" "origin/$branch"
    printf 'Tracking origin/%s\n' "$branch"
  else
    run_setup_command git -C "$main_dir" worktree add --no-track -b "$branch" "$worktree" origin/main
  fi
  setup_worktree "$worktree"
}

release_worktree_path() {
  git -C "$1" switch --detach origin/main
}

release() {
  local name="$1"
  local worktree

  validate_worktree_name "$name"
  worktree="$(worktrees_dir)/$name"

  [[ -d "$worktree" ]] || die "Cannot find worktree: $worktree"
  require_registered_worktree "$worktree"
  require_clean_worktree "$worktree"
  release_worktree_path "$worktree"
}

require_removable_worktree() {
  local worktree="$1"
  local name="${worktree##*/}"
  [[ "$name" != 'dev' && "$name" != 'fix' ]] || die "Persistent worktrees cannot be removed"
  [[ -d "$worktree" ]] || die "Cannot find worktree: $worktree"
  require_registered_worktree "$worktree"
  require_clean_worktree "$worktree"
}

remove_worktree_path() {
  local worktree="$1"
  git -C "$main_dir" worktree remove "$worktree"
  printf 'Removed worktree. Delete its branch separately when appropriate: %s\n' "${worktree##*/}"
}

remove_worktree() {
  local name="$1"
  local worktree

  validate_worktree_name "$name"
  worktree="$(worktrees_dir)/$name"
  require_removable_worktree "$worktree"
  remove_worktree_path "$worktree"
}

purge_worktrees() {
  local worktrees_root
  local registered_paths
  local locked_paths
  local locked_worktree
  local worktree
  local name
  local answer
  local -a candidates=()

  worktrees_root="$(worktrees_dir)"
  registered_paths="$(worktree_paths)" || return
  locked_paths="$(git -C "$main_dir" worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10) }
    /^locked($| )/ { print path }
  ')" || return
  while IFS= read -r -u 3 worktree; do
    [[ "$worktree" == "$worktrees_root/"* ]] || continue
    name="${worktree#"$worktrees_root/"}"
    [[ "$name" != */* && "$name" != 'dev' && "$name" != 'fix' ]] || continue
    require_removable_worktree "$worktree"
    while IFS= read -r -u 4 locked_worktree; do
      [[ "$worktree" != "$locked_worktree" ]] || die "Worktree is locked: $worktree"
    done 4<<< "$locked_paths"
    candidates+=("$worktree")
  done 3<<< "$registered_paths"

  if [[ ${#candidates[@]} -eq 0 ]]; then
    printf 'No feature worktrees to purge.\n'
    return
  fi

  [[ -t 0 ]] || die "Purge requires an interactive terminal"
  printf 'Purge these worktrees:\n' >&2
  for worktree in "${candidates[@]}"; do
    printf '  %s\n' "${worktree##*/}" >&2
  done
  printf "Type 'purge' to confirm: " >&2
  IFS= read -r answer || die "Cannot read purge confirmation"
  if [[ "$answer" != 'purge' ]]; then
    printf 'Purge cancelled.\n'
    return
  fi

  for worktree in "${candidates[@]}"; do
    release_worktree_path "$worktree"
    remove_worktree_path "$worktree"
  done
}

status() {
  local worktree
  local parent
  local registered_paths
  local summary
  local diff_summary
  local green=''
  local amber=''
  local red=''
  local reset=''

  if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    green=$'\033[32m'
    amber=$'\033[33m'
    red=$'\033[31m'
    reset=$'\033[0m'
  fi

  parent="$(dirname "$main_dir")"
  registered_paths="$(worktree_paths)" || return
  while IFS= read -r -u 3 worktree; do
    if [[ ! -d "$worktree" ]]; then
      printf '%s%s | unavailable or prunable%s\n' "$red" "${worktree#"$parent/"}" "$reset"
      continue
    fi

    summary="$(git -C "$worktree" status --porcelain --branch --untracked-files=all | awk \
      -v green="$green" -v amber="$amber" -v red="$red" -v reset="$reset" '
      NR == 1 { branch = substr($0, 4); next }
      /^\?\?/ { untracked++; next }
      /^(DD|AU|UD|UA|DU|AA|UU) / { conflicted = 1 }
      { changed++ }
      END {
        colour = conflicted ? red : (changed || untracked ? amber : green)
        printf "[%s] | %s%d changed, %d untracked%s", branch, colour, changed, untracked, reset
      }
    ')" || return
    diff_summary="$(git -C "$worktree" diff --no-ext-diff --numstat HEAD -- | awk \
      -v green="$green" -v amber="$amber" -v red="$red" -v reset="$reset" '
      $1 == "-" { binary++; next }
      { added += $1; deleted += $2 }
      END {
        printf "%s+%d%s %s-%d%s", green, added, reset, red, deleted, reset
        if (binary) printf " | %s%d binary%s", amber, binary, reset
      }
    ')" || return
    printf '%s %s | %s\n' "${worktree#"$parent/"}" "$summary" "$diff_summary"
  done 3<<< "$registered_paths"
}

show_status_after_operation() {
  local exit_code=$?
  trap - EXIT
  if ! status; then
    printf 'gt-tortus-worktree: Cannot show status\n' >&2
    [[ "$exit_code" -ne 0 ]] || exit_code=1
  fi
  exit "$exit_code"
}

usage_error() {
  usage >&2
  exit 1
}

TIMEFORMAT=$'\nCompleted in %2Rs'
time (
  arguments=()
  for argument in "$@"; do
    case "$argument" in
      --verbose|-v) verbose=true ;;
      --help|-h) usage; exit 0 ;;
      *) arguments+=("$argument") ;;
    esac
  done

  command="${arguments[0]:-}"
  case "$command" in
    init)
      [[ ${#arguments[@]} -eq 1 ]] || usage_error
      require_main_worktree
      require_shared_directory
      trap show_status_after_operation EXIT
      init_worktrees
      ;;
    new)
      [[ ${#arguments[@]} -eq 2 ]] || usage_error
      require_main_worktree
      require_shared_directory
      trap show_status_after_operation EXIT
      new_worktree "${arguments[1]}"
      ;;
    release)
      [[ ${#arguments[@]} -eq 2 ]] || usage_error
      require_main_worktree
      trap show_status_after_operation EXIT
      release "${arguments[1]}"
      ;;
    remove)
      [[ ${#arguments[@]} -eq 2 ]] || usage_error
      require_main_worktree
      trap show_status_after_operation EXIT
      remove_worktree "${arguments[1]}"
      ;;
    purge)
      [[ ${#arguments[@]} -eq 1 ]] || usage_error
      require_main_worktree
      trap show_status_after_operation EXIT
      purge_worktrees
      ;;
    status)
      [[ ${#arguments[@]} -eq 1 ]] || usage_error
      require_main_worktree
      status
      ;;
    '')
      usage
      ;;
    *)
      usage_error
      ;;
  esac
)
